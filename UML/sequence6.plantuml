@startuml
actor "Сотрудник" as Employee
actor "Менеджер" as Manager
actor "Администратор" as Admin
participant "Система управления контактами" as CRM
database "База данных" as DB

== Создание задания ==
group Сотрудник
  Employee -> CRM: Создать задание (детали задания)
  Employee++
  CRM++
  CRM -> DB: Сохранить задание
  DB++
  DB -> DB : Выполнение запроса
  DB --> CRM: Подтверждение сохранения
  DB--
  CRM --> Employee: Уведомление о создании задания
  Employee--
end

group Менеджер
  Manager -> CRM: Создать задание (исполнитель: сотрудник)
  Manager++
  CRM -> DB: Сохранить задание
  DB++
  DB -> DB : Выполнение запроса
  DB --> CRM: Подтверждение сохранения
  DB--
  CRM --> Manager: Уведомление о создании задания
  Manager--
  CRM --> Employee: Уведомление о назначении задания
  Employee++
  Employee--
end
|||
== Изменение задания ==
group Сотрудник
  Employee -> CRM: Изменить задание (детали задания)
  Employee++
  CRM -> DB: Сохранить задание
  DB++
  DB -> DB : Выполнение запроса
  DB --> CRM: Подтверждение сохранения
  DB--
  CRM --> Employee: Уведомление об изменениях задания
  Employee--
end

group Менеджер
  Manager -> CRM: Изменить исполнитель задания
  Manager++
  CRM -> DB: Обновить данные задания (новый исполнитель)
  DB++
  DB -> DB : Выполнение запроса
  DB --> CRM: Подтверждение обновления
  DB--
  CRM --> Manager: Уведомление об успешном изменении
  Manager--
  CRM --> Employee: Уведомление об изменении исполнителя
  Employee++
  Employee--
end
|||
== Завершение задания ==
group Сотрудник
  Employee -> CRM: Отметить задание как выполненное
  Employee++
  CRM -> DB: Обновить статус задания (выполнено) и дату завершения
  DB++
  DB -> DB : Выполнение запроса
  DB--
  DB --> CRM: Подтверждение обновления
  CRM --> Employee: Уведомление об успешном завершении задания
  Employee--
end

group Менеджер
  Manager -> CRM: Отметить задание как выполненное
  Manager++
  CRM -> DB: Обновить статус задания (выполнено) и дату завершения
  DB++
  DB -> DB : Выполнение запроса
  DB --> CRM: Подтверждение обновления
  DB--
  CRM --> Manager: Уведомление об успешном завершении задания
  Manager--
  CRM --> Employee: Уведомление об успешном завершении задания
  Employee++
  Employee--
end
|||
== Поиск клиентов и контактных лиц ==
group Сотрудник
  Employee -> CRM: Искать клиента/контактное лицо (параметры поиска)
  Employee++
  CRM -> DB: Запрос данных клиентов/контактных лиц
  DB++
  DB -> DB : Выполнение запроса
  DB --> CRM: Результаты поиска
  DB--
  CRM --> Employee: Вывести найденные данные
  Employee--
end

group Менеджер
  Manager -> CRM: Искать клиента/контактное лицо (параметры поиска)
  Manager++
  CRM -> DB: Запрос данных клиентов/контактных лиц
  DB++
  DB -> DB : Выполнение запроса
  DB --> CRM: Результаты поиска
  DB--
  CRM --> Manager: Вывести найденные данные
  Manager--
end

group Администратор
  Admin -> CRM: Искать клиента/контактное лицо (параметры поиска)
  Admin++
  CRM -> DB: Запрос данных клиентов/контактных лиц
  DB++
  DB -> DB : Выполнение запроса
  DB --> CRM: Результаты поиска
  DB--
  CRM --> Admin: Вывести найденные данные
  Admin--
end
|||
== Генерация отчёта по заданиям ==
Manager -> CRM: Запрос отчёта по заданиям (период, сотрудник)
Manager++
CRM -> DB: Запрос данных по заданиям
DB++
DB -> DB : Выполнение запроса
DB --> CRM: Данные для отчёта
DB--
CRM --> Manager: Сформированный отчёт
Manager--
|||
== Удаление старых завершённых заданий ==
CRM -> DB: Запрос на удаление завершённых заданий старше 12 месяцев
DB --> CRM: Удаление завершённых заданий выполнено
|||
== Управление пользователями администратором ==
Admin -> CRM: Добавить/удалить пользователя
Admin++
CRM -> DB: Обновить данные пользователей
DB++
DB -> DB : Выполнение запроса
DB --> CRM: Подтверждение обновления
DB--
CRM --> Admin: Уведомление об успешной операции
Admin--
CRM--

@enduml
